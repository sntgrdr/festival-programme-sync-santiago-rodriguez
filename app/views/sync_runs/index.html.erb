<div class="max-w-5xl mx-auto px-4 py-8">
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-gray-900">Sync Runs</h1>
    <p class="text-gray-500">History of programme sync runs against the upstream festival system.</p>
  </header>

  <div class="overflow-x-auto rounded-lg border border-gray-200">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Started</th>
          <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Finished</th>
          <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Status</th>
          <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Created</th>
          <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Updated</th>
          <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Cancelled</th>
          <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Deleted</th>
          <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Error</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100 bg-white">
        <% @sync_runs.each do |run| %>
          <tr>
            <td class="px-4 py-3 text-sm text-gray-700"><%= run.started_at.strftime("%a %d %b, %-l:%M%P") %></td>
            <td class="px-4 py-3 text-sm text-gray-700"><%= run.finished_at&.strftime("%a %d %b, %-l:%M%P") || "—" %></td>
            <td class="px-4 py-3 text-sm">
              <% if run.success? %>
                <span class="inline-flex rounded-full bg-green-100 px-2 text-xs font-semibold leading-5 text-green-800">Success</span>
              <% elsif run.failed? %>
                <span class="inline-flex rounded-full bg-red-100 px-2 text-xs font-semibold leading-5 text-red-800">Failed</span>
              <% else %>
                <span class="inline-flex rounded-full bg-yellow-100 px-2 text-xs font-semibold leading-5 text-yellow-800">Running</span>
              <% end %>
            </td>
            <td class="px-4 py-3 text-sm text-gray-700"><%= run.screenings_created %></td>
            <td class="px-4 py-3 text-sm text-gray-700"><%= run.screenings_updated %></td>
            <td class="px-4 py-3 text-sm text-gray-700"><%= run.screenings_cancelled %></td>
            <td class="px-4 py-3 text-sm text-gray-700"><%= run.screenings_deleted %></td>
            <td class="px-4 py-3 text-sm text-red-700"><%= run.error_message %></td>
          </tr>
        <% end %>

        <% if @sync_runs.empty? %>
          <tr><td colspan="8" class="px-4 py-8 text-center text-gray-400">No sync runs yet.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
